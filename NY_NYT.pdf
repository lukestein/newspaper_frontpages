   <dc:creator>
    <rdf:Seq>
     <rdf:li>SAMEER AL-DOUMY</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A man holds a family picture of Maher al-Assad, the brother of the toppled Syrian president Bashar al-Assad, at his villa in the town of Yafour near Damascus on December 23, 2024. Three rights group on December 23, appealed to Syria's new rulers to urgently preserve evidence of atrocities committed under former president Bashar al-Assad. (Photo by Sameer Al-DOUMY / AFP)</rdf:li>
    </rdf:Alt>
   </dc:description>
